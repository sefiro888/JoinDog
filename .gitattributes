# Auto detect text files and perform LF normalization
* text=auto

# Unity files
*.cs text diff=csharp
*.unity text
*.prefab text
*.asset text
*.meta text
*.json text
*.xml text
*.yml text
*.yaml text
*.md text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
